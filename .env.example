# Application identity
APP_NAME=Email Analysis Agent
VERSION=0.1.0

# Runtime behaviour
DEBUG=false
LOG_LEVEL=INFO
DATA_DIRECTORY=data

# Reserved for a future semantic-analysis integration. Do not commit real values.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=

# Production Hardening Phase 1: Redis State
REDIS_URL=redis://localhost:6379/0

# Production Hardening Phase 2: Live Threat Intelligence (Do not commit real values)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ABUSEIPDB_API_KEY=

# Production Hardening Phase 3: Real Enterprise Remediation (Do not commit real values)
MSGRAPH_REMEDIATION_TENANT_ID=
MSGRAPH_REMEDIATION_CLIENT_ID=
MSGRAPH_REMEDIATION_CLIENT_SECRET=
PANOS_HOST=
PANOS_API_KEY=

# Production Hardening Phase 4.1: PostgreSQL + pgvector (Do not commit real values)
PGVECTOR_ENABLED=false
PGVECTOR_URL=postgresql://scamon_user:password@localhost:5432/scamon

# Production Hardening Phase 4.2: Dense Neural Embeddings (Do not commit real values)
EMBEDDING_ENABLED=false
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004

# Production Hardening Phase 4.3: Semantic Incident RAG (Do not commit real values)
RAG_ENABLED=true
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.70
RAG_MAX_RESULTS=5
RAG_MAX_CONTEXT_CHARS=4000
RAG_MAX_INCIDENT_CHARS=800

# Gmail Integration Configuration (Paths to OAuth credential & token JSON files)
# GMAIL_CREDENTIALS_PATH=credentials.json
# GMAIL_TOKEN_PATH=token.json
