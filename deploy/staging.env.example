# ==============================================================================
# ScamON Enterprise Email Analysis Agent - Staging Environment Configuration
# ==============================================================================

# Core System
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=staging-super-secret-key-32-chars-long!
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Core AI (Groq LLM)
GROQ_API_KEY=gsk_staging_placeholder_key_not_real
GROQ_MODEL=openai/gpt-oss-20b

# Production Hardening Phase 1: Redis Infrastructure
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20
REDIS_TIMEOUT_SEC=2.0
RATE_LIMIT_ENABLED=true
TENANT_LOCK_TTL_SEC=30

# Production Hardening Phase 2: Live Threat Intelligence (Optional for Staging)
THREAT_INTEL_CIRCUIT_BREAKER_ENABLED=true
THREAT_INTEL_FAIL_SILENT=true
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ABUSEIPDB_API_KEY=

# Production Hardening Phase 3: Real Enterprise Remediation (Dry Run by Default)
REMEDIATION_DRY_RUN=true
MSGRAPH_REMEDIATION_TENANT_ID=
MSGRAPH_REMEDIATION_CLIENT_ID=
MSGRAPH_REMEDIATION_CLIENT_SECRET=
PANOS_HOST=
PANOS_API_KEY=

# Production Hardening Phase 4.1: PostgreSQL + pgvector
PGVECTOR_ENABLED=true
PGVECTOR_URL=postgresql://scamon_user:scamon_staging_password@localhost:5432/scamon

# Production Hardening Phase 4.2: Dense Neural Embeddings
EMBEDDING_ENABLED=false
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004

# Production Hardening Phase 4.3: Semantic Incident RAG
RAG_ENABLED=true
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.70
RAG_MAX_RESULTS=5
RAG_MAX_CONTEXT_CHARS=4000
RAG_MAX_INCIDENT_CHARS=800
